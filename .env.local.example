# Copy to .env.local for local development. The same keys go into the Vercel
# project's Environment Variables, per environment — see "Deploying to Vercel"
# in the README. NEXT_PUBLIC_* values are inlined into the client bundle at
# build time, so changing one needs a redeploy, not just a restart.

# ---------------------------------------------------------------------------
# Clerk — https://dashboard.clerk.com  →  API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Where Clerk sends users. These match the routes in src/app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard  →  Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# SERVER ONLY. The *secret* key (sb_secret_... , formerly service_role) from
# Project Settings -> API Keys -> Secret keys. NOT the publishable key, which is
# a browser key and is blocked by the RLS policies in supabase/schema.sql.
# Never prefix this with NEXT_PUBLIC_ and never import it into a "use client" file.
SUPABASE_SECRET_KEY=sb_secret_...

# Private storage bucket that holds the captured photos.
SUPABASE_PHOTOS_BUCKET=photos

# ---------------------------------------------------------------------------
# Storage backend for the image bytes: "supabase" or "cloudinary".
# The Supabase `photos` table is used for metadata either way.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=supabase

# Cloudinary — https://console.cloudinary.com → Settings → API Keys
# Only needed when STORAGE_PROVIDER=cloudinary. All three are SERVER ONLY.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=live-photos

# ---------------------------------------------------------------------------
# Supabase personal access token — LOCAL TOOLING ONLY, never deployed.
#
# Only `npm run db:migrate` reads this. PostgREST cannot execute DDL and the
# secret key above is not a Postgres credential, so schema changes go through
# the Management API, which authenticates with an account-wide token instead.
#
# Create one at https://supabase.com/dashboard/account/tokens
#
# This grants far more than the app's own keys do — it reaches every project on
# the account — so do NOT add it to Vercel or any deployed environment.
# ---------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Gemini — dress-code verification. Only the queue worker reads these.
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Flash-Lite is deliberate. It is the tier that accepts thinkingLevel "minimal";
# gemini-3.8-flash cannot go below "low", and thinking tokens bill at the output
# rate — several times the cost for the same yes/no uniform verdict.
GEMINI_MODEL=gemini-3.5-flash-lite

# Hard ceiling on model calls per day across the deployment. Checks beyond it
# stay queued and resume tomorrow, so a runaway loop costs nothing.
GEMINI_DAILY_CALL_CAP=500

# Shared secret Vercel Cron presents to /api/cron/dress-checks. Without it the
# worker — and the spend behind it — is triggerable by anyone. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
